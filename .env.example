ENVIROMENT=local
PORT=4200

# --- database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=dh
# true for a hosted database like Neon (it accepts only encrypted connections), false for a local one
DB_SSL=false

# --- auth ---
JWT_SECRET=change-me
JWT_EXPIRE=10m
JWT_REFRESH_EXPIRE=30m

# --- email ---
# Option 1: SMTP (any provider). When SMTP_HOST is set, it is used.
# Brevo: SMTP & API -> SMTP tab. The login looks like 8f3a1b001@smtp-brevo.com, the password is the SMTP key (xsmtpsib-...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Option 2: Brevo API (used when SMTP_HOST is empty)
# API key from Brevo: SMTP & API -> API keys. Without it nothing is sent locally
# (the invitation link is printed in the terminal), in production the app refuses to send.
BREVO_API_KEY=
# sender address, has to be a verified sender in Brevo (Senders, domains & dedicated IPs)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=DH
# true: Brevo only checks the request and nothing is delivered (needs a real key). Use false to really send.
BREVO_SANDBOX=false
APP_NAME=DH
# dashboard address, used in the links of the emails and for CORS.
# local: http://localhost:4300, production: the one real domain, e.g. https://app.example.com
APP_DASHBOARD=http://localhost:4300

# --- first super admin, created by the seeder on an empty database ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
