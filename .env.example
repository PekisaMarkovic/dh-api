ENVIROMENT=local
PORT=4200

# --- database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=password
DB_NAME=dh
# Encrypted connection (sslmode=require). Leave it out for the automatic choice:
# on everywhere except ENVIROMENT=local. true / false forces it.
DB_SSL=false

# --- auth ---
JWT_SECRET=change-me
JWT_EXPIRE=10m
JWT_REFRESH_EXPIRE=30m

# --- email ---
# SMTP, e.g. a Gmail account: SMTP_HOST=smtp.gmail.com, SMTP_USER=the gmail address,
# SMTP_PASSWORD=an app password (myaccount.google.com/apppasswords, needs 2-step verification),
# MAIL_FROM_EMAIL=the same gmail address.
# Without it nothing is sent locally (the invitation link is printed in the terminal),
# in production the app refuses to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=DH
APP_NAME=DH
# dashboard address, used in the links of the emails and for CORS.
# local: http://localhost:4300, production: the one real domain, e.g. https://app.example.com
APP_DASHBOARD=http://localhost:4300

# --- first super admin, created by the seeder on an empty database ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
